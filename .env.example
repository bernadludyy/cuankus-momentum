MIN_MARKET_CAP_IDR=300000000000
MAX_MARKET_CAP_IDR=10000000000000
FILTER1_VALUE_MA50_ENABLED=true
FILTER1_MIN_VALUE_MA50_IDR=5000000000
FILTER1_TOP_N_ALERTS_PER_CYCLE=2
FILTER1_SOLO_MODE_ENABLED=true
FILTER1_SOLO_WATCH_QUALITY_MIN=65
FILTER1_SOLO_ENTRY_QUALITY_MIN=75
FILTER1_SOLO_ENTRY_MICRO_MIN=60
FILTER1_SOLO_ENTRY_AGGRESSIVE_BUY_MIN=0.60
FILTER1_SOLO_ENTRY_BID_MIN=55
FILTER1_SOLO_ENTRY_NET_AGGRESSION_MIN_IDR=50000000
FILTER1_SOLO_ENTRY_POSITION_MIN=0.75
FILTER1_SOLO_ENTRY_ACTIVITY_MIN=1.50
FILTER1_SOLO_ENTRY_BREAKOUT_MAX_PCT=1.50
FILTER1_SOLO_ENTRY_DAILY_CHANGE_MIN_PCT=0.00
FILTER1_SOLO_ENTRY_DAILY_CHANGE_MAX_PCT=6.00
FILTER1_SOLO_BREAKOUT_HOLD_SNAPSHOTS=2
FILTER1_SOLO_MAX_STRUCTURE_RISK_PCT=3.00

