# ===== ZPI / ZAPI =====
ZPI_API_KEY=
ZPI_BASE_URL=https://api.zapi.ink/v1/finance:pluang

ZPI_QUOTE_PATH=quote
ZPI_SUMMARY_PATH=summary
ZPI_BROKER_PATH=
VOLUME_BY_PRICE_ENABLED=true

# ===== TELEGRAM BOT 4 =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== SCANNER =====
USE_MULTI_QUOTE=true
BATCH_SIZE=20
RECENT_SNAPSHOTS=12
MIN_BASELINE_INTERVALS=4

LEAKAGE_THRESHOLD=70
MOMENTUM_THRESHOLD=80
ALERT_COOLDOWN_MINUTES=30

MIN_DAILY_CHANGE_FOR_LEAKAGE=-2.0
MAX_DAILY_CHANGE_FOR_LEAKAGE=4.0
MAX_DAILY_CHANGE_FOR_MOMENTUM=10.0

MIN_ACTIVITY_SPIKE=1.5
MIN_BREAKOUT_PCT=0.30
MIN_MOMENTUM_INTERVAL_RETURN_PCT=0.35

DAILY_FILTER_ENABLED=true
VOLUME_MA_SHORT=10
VOLUME_MA_LONG=100
VOLUME_MA_RATIO_MIN=1.5
VALUE_MA_WINDOW=5
MIN_VALUE_MA_IDR=3000000000
DAILY_FILTER_CACHE_HOURS=18
STOCK_HISTORY_LENGTH=120

# ===== FILTER 1 SOLO CONFIRMATION (PRIVATE ONLY) =====
